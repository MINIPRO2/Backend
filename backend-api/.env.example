# Puerto del servidor API
PORT=4000
NODE_ENV=development

# Origen permitido por CORS (en producción usar el dominio de Vercel, o * separado por comas)
CORS_ORIGIN=http://localhost:5173

# Credenciales de Firebase Admin SDK (Firestore & Auth)
# Opción 1: Variables individuales extraídas del JSON de Service Account de Firebase
FIREBASE_PROJECT_ID=tu-proyecto-firebase-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-proyecto-firebase-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_CLAVE_PRIVADA_AQUI\n-----END PRIVATE KEY-----\n"

# Opción 2 (alternativa): JSON completo en una sola línea (útil en Render)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
